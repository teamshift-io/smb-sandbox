{
  "name": "@teamshift/smb-workflows",
  "version": "0.1.0",
  "description": "Verified small-business tasks for AI agents (quote follow-up, missed-call callbacks, invoice reminders, CRM cleanup and more), each graded on the end state of a sandboxed business, not on what the agent says it did.",
  "keywords": [
    "ai agent evaluation",
    "agent benchmark",
    "llm evals",
    "business automation",
    "mcp",
    "model context protocol",
    "ai agents",
    "small business",
    "agent testing",
    "evals"
  ],
  "license": "Apache-2.0",
  "author": "TeamShift (https://teamshift.io)",
  "homepage": "https://teamshift.io/open-source/smb-sandbox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teamshift-io/smb-sandbox.git",
    "directory": "workflows"
  },
  "bugs": {
    "url": "https://github.com/teamshift-io/smb-sandbox/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "smb-workflows": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@teamshift/fake-business": "workspace:*",
    "@teamshift/sandbox-mcp": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
