{
  "name": "@teamshift/sandbox-mcp",
  "version": "0.1.0",
  "description": "Mock small-business MCP servers (CRM, inbox, calendar, invoicing, phone) backed by a realistic fictional company, for testing AI agents end-to-end without real accounts.",
  "keywords": [
    "mcp",
    "mcp server",
    "model context protocol",
    "ai agents",
    "sandbox",
    "mock crm",
    "testing",
    "llm evaluation",
    "agent evaluation",
    "synthetic data"
  ],
  "license": "Apache-2.0",
  "author": "TeamShift (https://teamshift.io)",
  "homepage": "https://teamshift.io/open-source/smb-sandbox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teamshift-io/smb-sandbox.git",
    "directory": "packages/sandbox-mcp"
  },
  "bugs": "https://github.com/teamshift-io/smb-sandbox/issues",
  "mcpName": "io.github.teamshift-io/sandbox-mcp",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "sandbox-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@teamshift/fake-business": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
